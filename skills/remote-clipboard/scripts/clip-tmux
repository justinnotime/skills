#!/bin/sh
# Resolve a deployment symlink so this also works from a user's bin directory.
exec python3 -c 'import pathlib,runpy,sys; p=pathlib.Path(sys.argv.pop(1)).resolve().with_name("clipboard.py"); sys.argv[0]=str(p); sys.argv.insert(1,"tmux"); runpy.run_path(str(p),run_name="__main__")' "$0" "$@"
