#!/bin/sh
# Resolve deployment symlinks before loading the package-local runtime.
exec python3 -c 'import pathlib,runpy,sys; p=pathlib.Path(sys.argv.pop(1)).resolve().with_name("clipboard.py"); sys.path.insert(0,str(p.parent)); sys.argv[0]=str(p); sys.argv.insert(1,"terminal"); runpy.run_path(str(p),run_name="__main__")' "$0" "$@"
