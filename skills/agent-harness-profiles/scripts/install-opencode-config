#!/usr/bin/env python3
"""Install generated OpenCode JSON and keep literal provider keys in native auth."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import sys
import tempfile


class Invalid(ValueError):
    pass


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise Invalid("duplicate JSON field")
        result[key] = value
    return result


def read_json(text):
    value = json.loads(text, object_pairs_hook=unique_object)
    if not isinstance(value, dict):
        raise Invalid("expected a JSON object")
    return value


def separate(config, auth):
    providers = config.get("provider", {})
    if not isinstance(providers, dict):
        raise Invalid("provider must be an object")
    credentials = []
    for name, provider in providers.items():
        if not isinstance(provider, dict):
            raise Invalid("provider entry must be an object")
        options = provider.get("options", {})
        if not isinstance(options, dict):
            raise Invalid("provider options must be an object")
        if "apiKey" not in options:
            continue
        key = options["apiKey"]
        if not isinstance(key, str) or not key.strip():
            raise Invalid("apiKey must be a nonempty string; omit it for native auth")
        if re.fullmatch(r"\{(?:env|file):[^{}]+\}", key):
            continue
        if "{env:" in key or "{file:" in key:
            raise Invalid("malformed native credential reference")
        del options["apiKey"]
        auth[name] = {"type": "api", "key": key}
        credentials.append(key)
    # Catch another occurrence of a selected literal, without printing it.
    def contains_selected(value):
        if isinstance(value, str):
            return any(key in value for key in credentials)
        if isinstance(value, dict):
            return any(contains_selected(k) or contains_selected(v) for k, v in value.items())
        if isinstance(value, list):
            return any(contains_selected(v) for v in value)
        return False

    if contains_selected(config):
        raise Invalid("a selected credential also occurs outside provider options")
    return len(credentials)


def atomic_write(path, content):
    fd, temporary = tempfile.mkstemp(prefix=".opencode-config-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def encode(value):
    return (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode()


def install(input_text, config_dir, data_dir, check=False):
    config_dir, data_dir = config_dir.resolve(), data_dir.resolve()
    if config_dir == data_dir or config_dir in data_dir.parents or data_dir in config_dir.parents:
        raise Invalid("configuration and credential directories must not overlap")
    config_path, auth_path = config_dir / "opencode.json", data_dir / "auth.json"
    for path in (config_path, auth_path):
        if path.is_symlink() or (path.exists() and not path.is_file()):
            raise Invalid("destination must be an absent or regular native file")
    # Preflight before creating directories or a lock, including in --check mode.
    config = read_json(input_text)
    before = auth_path.read_bytes() if auth_path.exists() else None
    auth = read_json(before) if before is not None else {}
    count = separate(config, auth)
    if check:
        return count
    config_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    data_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (data_dir / ".opencode-config.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        # Re-read under this installer's lock so repeated imports preserve each other.
        before = auth_path.read_bytes() if auth_path.exists() else None
        auth = read_json(before) if before is not None else {}
        config = read_json(input_text)
        count = separate(config, auth)
        if count:
            atomic_write(auth_path, encode(auth))
        try:
            atomic_write(config_path, encode(config))
        except OSError:
            if count:
                if before is None:
                    auth_path.unlink()
                else:
                    atomic_write(auth_path, before)
            raise
    return count


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input", required=True, help="generated JSON file, or - for stdin")
    parser.add_argument("--profile-root", type=Path, help="explicit root containing share/config/state")
    parser.add_argument("--config-dir", type=Path, help="explicit native config directory")
    parser.add_argument("--data-dir", type=Path, help="explicit native data directory")
    parser.add_argument("--check", action="store_true", help="validate without writing files or printing keys")
    args = parser.parse_args()
    if args.profile_root and (args.config_dir or args.data_dir):
        parser.error("--profile-root cannot be combined with native directory overrides")
    if bool(args.config_dir) != bool(args.data_dir):
        parser.error("specify both --config-dir and --data-dir")
    home = Path.home()
    config_dir = args.config_dir or Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")) / "opencode"
    data_dir = args.data_dir or Path(os.environ.get("XDG_DATA_HOME", home / ".local/share")) / "opencode"
    if args.profile_root:
        config_dir = args.profile_root / "config/opencode"
        data_dir = args.profile_root / "share/opencode"
    try:
        content = sys.stdin.read() if args.input == "-" else Path(args.input).read_text()
        count = install(content, config_dir, data_dir, args.check)
        print(f"OK {'validated' if args.check else 'installed'} OpenCode config; {count} literal provider credential(s) separated")
        return 0
    except (OSError, ValueError, TypeError):
        # Input, JSON fields and OS filenames may contain private content.
        print("FAIL OpenCode config import; check JSON, credential references and native destinations", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
