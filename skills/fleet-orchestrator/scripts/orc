#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="$HERE/lib/fleet-profile.py"

if [[ "${1:-}" == "--config" ]]; then
  (($# >= 3)) || { echo "usage: orc --config FILE <command> [...]" >&2; exit 2; }
  export FLEET_ORCHESTRATOR_CONFIG="$2"
  shift 2
fi

if [[ "${1:-}" == "fleet" ]]; then
  (($# >= 2)) || {
    echo "usage: orc fleet start|window|rename|stop|show|tick [...]" >&2
    exit 2
  }
  action=$2
  shift 2
  case "$action" in
    create|start)
      exec python3 "$PROFILE" create "$@"
      ;;
    window|stop|rename)
      exec python3 "$PROFILE" "$action" "$@"
      ;;
    show)
      exec python3 "$PROFILE" resolve "$@"
      ;;
    apply-tmux)
      exec python3 "$PROFILE" apply-tmux "$@"
      ;;
    tick)
      exec python3 "$HERE/fleet-tick.py" "$@"
      ;;
    *)
      echo "usage: orc fleet start|window|rename|stop|show|tick [...]" >&2
      exit 2
      ;;
  esac
fi

selection=()
if [[ "${1:-}" == "--fleet" ]]; then
  (($# >= 3)) || { echo "usage: orc --fleet <name> <command> [...]" >&2; exit 2; }
  selection=(--fleet "$2")
  shift 2
fi
if [[ "${1:-}" == "tview" ]]; then
  shift
  exec "$HERE/tview" "${selection[@]}" "$@"
fi
exec python3 "$PROFILE" exec-current "${selection[@]}" -- python3 "$HERE/fleet-orchestrator.py" "$@"
