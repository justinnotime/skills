#!/usr/bin/env python3
"""Fleet-first public entry. Legacy spellings forward to the same handlers."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
HERE = Path(__file__).resolve().parent

GROUPS = {
    "task": {
        "list": "List tasks; --all includes closed work",
        "show": "Read one task and its full history",
        "brief": "Read work waiting for the operator, with full request text",
        "open": "Record a task without sending it to its recipient",
        "dispatch": "Record a task and send it to its recipient",
        "ack": "Acknowledge and accept a task",
        "note": "Record progress without claiming completion",
        "blocked": "Record what decision is needed and who must make it",
        "reassign": "Change the recipient, PR author or reviewer",
        "claim-done": "Request independent completion review; does not close the task",
        "close": "Close with a resolution after the required verification",
        "chase": "Record a follow-up and schedule another check",
        "link": "Connect tasks with a dependency or other typed relationship",
        "handshake": "Wait for message presentation or task-response evidence",
        "announce": "Send an announcement to selected recipients",
    },
    "review": {
        "verdict": "Reviewer records blockers or a clean review",
        "receipt": "PR author records verification evidence for the merge decision",
    },
    "goal": {
        "list": "List current goals and their dependencies",
        "show": "Read one goal and its child tasks, including history",
        "open": "Create a parent goal for related tasks",
        "team": "Add or list the people assigned to one goal",
    },
    "agent": {
        "list": "List registered members and their terminal windows",
        "onboard": "Read an agent's tasks, roles and predecessor handoff",
        "role": "Grant, revoke or list fleet responsibilities",
        "topology": "Inspect current agents, panes, roles and registration gaps",
        "checkout": "Write a handoff and retire an agent after obligations clear",
        "pane-succession": "Retire an absent predecessor with no outstanding obligations",
    },
    "admin": {
        "doctor": "Diagnose task consistency and scheduler freshness",
        "verify": "Verify stored task relationships and event history",
        "snapshot": "Write a backup of the task database",
        "tick": "Run scheduled checks and reminders; --dry-run only inspects",
        "overdue": "List tasks due for a check; --run-checks executes their checks",
        "import-state": "Import historical state from the former scheduler",
        "config": "Inspect the selected fleet's resolved runtime configuration",
    },
}
WORKFLOWS = {
    "task": "Work: open -> ack -> note -> claim-done -> independent verification -> close.\n"
            "Use dispatch instead of open when the recipient must also be notified.\n"
            "blocked and reassign handle a missing decision or a change of responsibility.",
    "review": "PR work: task open/dispatch --workflow pr -> readiness check -> review verdict.\n"
              "Blockers return work to the author; a clean verdict requires review receipt.\n"
              "A receipt supplies evidence, never merge permission.",
    "goal": "A goal is a parent task. Attach work with task open --parent GOAL_ID.\n"
            "A goal team role overrides the same fleet role for that goal's tasks;\n"
            "task link records dependencies.",
    "agent": "agent role assigns a fleet responsibility; goal team assigns people to one goal.\n"
             "onboard reads existing registration. Join from the actual agent pane with\n"
             f"{HERE / 'agent-boot.sh'} TASK_SLUG.\n"
             f"Joining procedure: {HERE.parent / 'references/agent-bus.md'} "
             "(Join the current session).",
    "admin": "The configured scheduler owns real ticks. Use tick --dry-run for inspection.\n"
             "Unselected 'orc admin tick' covers configured fleets; a named fleet limits it.",
}
LEGACY_COMMANDS = {}
for _group, _commands in GROUPS.items():
    for _command in _commands:
        if _command != "config":
            LEGACY_COMMANDS.setdefault(_command, f"{_group} {_command}")
LEGACY_COMMANDS.update({
    "tree": "goal list (or goal show ID)",
    "statusline": "board --view summary",
    "kanban": "board --view columns",
})
LEGACY_LIFECYCLE = {"create": "create", "start": "create", "stop": "stop",
                    "window": "window", "rename": "rename", "show": "resolve",
                    "apply-tmux": "apply-tmux"}


def run_script(name, args, *, env=None):
    path = HERE / name
    command = ([str(path)] if path.suffix != ".py" else [sys.executable, str(path)])
    os.execvpe(command[0], [*command, *args], os.environ if env is None else env)


def group_help(name, prefix, *, file=None):
    print(f"Usage: {prefix} {name} COMMAND [OPTIONS]", file=file)
    print(file=file)
    for command, description in GROUPS[name].items():
        print(f"  {name + ' ' + command:<24} {description}", file=file)
    print(f"\n{WORKFLOWS[name]}", file=file)
    print(f"\nUse '{prefix} {name} COMMAND --help' for arguments.", file=file)


def root_help(prefix="orc", *, file=None):
    print("""Usage: orc                         List fleets and their work
       orc fleet NAME              Show one fleet's work
       orc fleet NAME COMMAND      Work inside that fleet
       orc -t NAME COMMAND         Short fleet selector, like tview -t
       orc help [GROUP|legacy]      Explain a command group or old spellings

Read work:
  overview                 Current goals and work in the selected fleet
  board                    Work table; --view table|columns|summary, --json, --repo
  goals                    Short form of goal list; --all includes history
  agents                   Short form of agent list

Fleet terminals:
  view [WIN]               Enter the same windows as tview -t NAME[:WIN]
  start                    Create or resume this fleet
  window                   Add a terminal window
  rename NEW               Rename this fleet while preserving saved work
  stop                     Stop its terminals and retain saved work""", file=file)
    for group, commands in GROUPS.items():
        print(f"\n{group.title()} commands:", file=file)
        for command, description in commands.items():
            print(f"  {group + ' ' + command:<24} {description}", file=file)
    print(f"""
Typical work: task open -> task ack -> task note -> task claim-done -> verification -> task close.
PR review: task dispatch --workflow pr -> readiness -> review verdict -> review receipt.
A receipt records evidence; merging requires its own authority.

Use '{prefix} GROUP --help' for relationships and '{prefix} GROUP COMMAND --help' for arguments.
Use '{prefix} help legacy' to map old flat commands to these groups.
A leading --config FILE selects private runtime settings.
Without an explicit selector, a command follows its actual tmux fleet.
Unselected 'orc admin tick' runs the configured fleet scheduler; add a fleet to limit it.""", file=file)


def legacy_help(prefix):
    print("Old spellings remain supported; use grouped commands for new work.\n")
    for command, target in LEGACY_COMMANDS.items():
        print(f"  {command:<18} {prefix} {target}")
    print("\nFor legacy tick's single-fleet behavior, use 'orc fleet NAME admin tick'.")
    print("overview, board, agents and fleet terminal commands remain direct entries.")


def requested_help(args, prefix):
    if not args or args in (["--help"], ["-h"], ["fleet"]):
        root_help(prefix)
        return 0
    if args == ["legacy"]:
        legacy_help(prefix)
        return 0
    if len(args) == 1 and args[0] in GROUPS:
        group_help(args[0], prefix)
        return 0
    print(f"orc: unknown help topic {' '.join(args)!r}\n", file=sys.stderr)
    root_help(prefix, file=sys.stderr)
    return 2


def inventory(profile, args):
    parser = argparse.ArgumentParser(prog="orc", description="Fleets and their current work")
    parser.add_argument("--json", action="store_true")
    opts = parser.parse_args(args)
    rows = profile.terminal_inventory()
    failed = False
    for row in rows:
        row["work"] = None
        if row["status"] != "invalid":
            try:
                env = profile.execution_env(row["name"])
                result = subprocess.run(
                    [sys.executable, str(HERE / "fleet-orchestrator.py"), "board", "--json"],
                    env=env, capture_output=True, text=True, timeout=20, check=False)
                if result.returncode:
                    raise ValueError("work could not be read; inspect this fleet with 'board'")
                data = json.loads(result.stdout)
                row["work"] = data["counts"]
                if data["warnings"]:
                    row["detail"] = "; ".join(filter(None, [row["detail"], *data["warnings"]]))
            except (OSError, ValueError, subprocess.TimeoutExpired, profile.FleetProfileError):
                row["detail"] = "work unavailable; inspect this fleet with 'board'"
                failed = True
        else:
            failed = True
    if opts.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        print(f"{'FLEET':<20} {'TERMINAL':<16} {'GOALS':>6} {'TASKS':>6} {'NEEDS YOU':>10}  ENTER")
        for row in rows:
            counts = row["work"]
            def count(key):
                return str(counts[key]) if counts is not None else "?"
            print(f"{row['name']:<20} {row['status']:<16} {count('goals'):>6} "
                  f"{count('tasks'):>6} {count('operator'):>10}  {row['command']}")
            if row["detail"]:
                print(f"  {row['detail']}")
        print("Open work: orc fleet NAME | Open terminals: tview -t NAME")
    return int(failed)


def main():
    args = sys.argv[1:]
    os.environ.pop("ORC_CLI_COMMAND", None)
    os.environ.pop("ORC_CLI_PROG", None)
    selected = None
    while args and args[0] in {"--config", "--fleet", "-f", "-t", "--target"}:
        flag = args.pop(0)
        if not args or not args[0] or args[0].startswith("-"):
            raise ValueError(f"{flag} requires a value")
        value = args.pop(0)
        if flag == "--config":
            os.environ["FLEET_ORCHESTRATOR_CONFIG"] = value
        elif selected is None:
            selected = value
        else:
            raise ValueError("select a fleet only once")
    prefix = f"orc fleet {selected}" if selected else "orc"
    if args in (["--help"], ["-h"]):
        root_help(prefix)
        return 0
    if args[:1] == ["help"]:
        return requested_help(args[1:], prefix)
    # Load after --config, so every selector sees exactly the same settings.
    sys.path.insert(0, str(HERE / "lib"))
    spec = importlib.util.spec_from_file_location("orc_fleet_profile", HERE / "lib/fleet-profile.py")
    profile = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(profile)
    try:
        if args and args[0] == "fleet":
            if selected is not None:
                raise ValueError("select a fleet only once")
            args = args[1:]
            if not args or args[0] == "list":
                return inventory(profile, args[1:] if args else [])
            if args[0] in {"--help", "-h"}:
                root_help()
                return 0
            # Old lifecycle forms are forwarded, never implemented separately.
            if args[0] == "tick":
                run_script("fleet-tick.py", args[1:])
            if args[0] in LEGACY_LIFECYCLE:
                run_script("lib/fleet-profile.py", [LEGACY_LIFECYCLE[args[0]], *args[1:]])
            selected, args = args[0], args[1:]
        if selected is None and (not args or args == ["--json"]):
            return inventory(profile, args)
        prefix = f"orc fleet {selected}" if selected else "orc"
        if args in (["--help"], ["-h"]):
            root_help(prefix)
            return 0
        if args[:1] == ["help"]:
            return requested_help(args[1:], prefix)
        if args[:2] == ["admin", "tick"] and selected is None:
            run_script("fleet-tick.py", args[2:])
        if args and args[0] in {"tview", "view"}:
            flags = ["--fleet", selected] if selected is not None else []
            run_script("tview", [*flags, *args[1:]])
        if not args:
            args = ["overview"]
        prefix = f"orc fleet {selected}" if selected else "orc"
        if args[0] in {"start", "stop", "window", "rename"}:
            action = args.pop(0)
            name = selected or profile.command_selection()
            run_script("lib/fleet-profile.py", ["create" if action == "start" else action, name, *args])
        if args[0] in {"goals", "agents"}:
            args = ["goal" if args[0] == "goals" else "agent", "list", *args[1:]]
        if args[0] in GROUPS:
            group, rest = args[0], args[1:]
            if rest and rest[0] in {"--help", "-h"}:
                group_help(group, prefix)
                return 0
            if not rest or rest[0].startswith("-"):
                if group not in {"task", "goal", "agent"}:
                    group_help(group, prefix)
                    return 0
                rest = ["list", *rest]
            action, tail = rest[0], rest[1:]
            os.environ["ORC_CLI_COMMAND"] = action
            if action not in GROUPS[group]:
                print(f"orc: unknown {group} command {action!r}\n", file=sys.stderr)
                group_help(group, prefix, file=sys.stderr)
                return 2
            prefix += " " + group
            if group == "goal":
                action = {"list": "tree", "show": "tree"}.get(action, action)
                if action == "open":
                    if any(x == "--workflow" or x.startswith("--workflow=") for x in tail):
                        raise ValueError("goal open already selects the goal workflow")
                    tail = [*tail, "--workflow", "parent"]
            elif group == "agent" and action == "list":
                action = "agents"
            elif group == "admin" and action == "config":
                run_script("lib/fleet-profile.py", ["resolve", selected or profile.command_selection(), *tail])
            args = [action, *tail]
        elif args[0] not in {"overview", "board", *LEGACY_COMMANDS}:
            print(f"orc: unknown command {args[0]!r}\n", file=sys.stderr)
            root_help(prefix, file=sys.stderr)
            return 2
        os.environ["ORC_CLI_PROG"] = prefix
        flags = ["--fleet", selected] if selected is not None else []
        run_script("lib/fleet-profile.py", ["exec-current", *flags, "--", sys.executable,
                                              str(HERE / "fleet-orchestrator.py"), *args])
    except profile.FleetProfileError as exc:
        raise ValueError(str(exc)) from exc


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, OSError) as exc:
        print(f"orc: {exc}", file=sys.stderr)
        raise SystemExit(2)
